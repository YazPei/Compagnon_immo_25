#!/usr/bin/env python3
# -*- coding: utf-8 -*-
from __future__ import annotations

import os, sys, traceback
from pathlib import Path
from typing import List, Tuple, Optional

import click
import numpy as np
import pandas as pd
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import silhouette_score
from sklearn.linear_model import LinearRegression
import matplotlib.pyplot as plt

# MLflow (tolérant)
try:
    import mlflow
    mlflow.set_tracking_uri(os.getenv("MLFLOW_TRACKING_URI", "file:" + os.path.abspath("./mlruns")))
    _HAS_MLFLOW = True
except Exception:
    class _NoMLF:  # no-op
        def set_experiment(self, *a, **k): ...
        def start_run(self, *a, **k): 
            class _R: 
                def __enter__(self): return self
                def __exit__(self, *e): return False
            return _R()
        def log_param(self, *a, **k): ...
        def log_artifact(self, *a, **k): ...
        def log_artifacts(self, *a, **k): ...
    mlflow = _NoMLF()
    _HAS_MLFLOW = False

def log(*args):
    msg = " ".join(str(a) for a in args)
    enc = sys.stdout.encoding or "utf-8"
    try: print(msg)
    except UnicodeEncodeError: print(msg.encode(enc, errors="replace").decode(enc, errors="replace"))

def ensure_dirs(*paths: Path) -> None:
    for p in paths: p.mkdir(parents=True, exist_ok=True)

def _read_csv(p: Path, parse_dates: List[str] | None = None) -> pd.DataFrame:
    if not p.exists(): raise FileNotFoundError(f"Introuvable: {p}")
    return pd.read_csv(p, sep=";", low_memory=False)

def _ensure_date(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    candidates = ["date","date_vente","date_transaction","date_mutation","DateMutation","DATETRANS"]
    col = next((c for c in candidates if c in df.columns), None)
    if col is None:
        # essayer à partir (annee, mois, jour)
        y = None
        for yk in ["annee","year","YEAR"]: 
            if yk in df.columns: y = pd.to_numeric(df[yk], errors="coerce"); break
        m = None
        for mk in ["mois","month","MONTH"]: 
            if mk in df.columns: m = pd.to_numeric(df[mk], errors="coerce"); break
        if y is not None and m is not None:
            df["date"] = pd.to_datetime(dict(year=y.fillna(method="ffill"),
                                             month=m.fillna(method="ffill"), day=1), errors="coerce")
        else:
            # dernier recours: tout au 1er du mois courant -> *au moins* une clé temporelle
            df["date"] = pd.Timestamp.today().normalize()
    else:
        df["date"] = pd.to_datetime(df[col], errors="coerce")
        df.loc[df["date"].isna(), "date"] = pd.Timestamp.today().normalize()
    return df

def _ensure_prix_m2(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    if "prix_m2_vente" not in df.columns:
        # classique: prix_bien / surface
        if "prix_bien" in df.columns and "surface" in df.columns:
            with np.errstate(divide="ignore", invalid="ignore"):
                df["prix_m2_vente"] = (pd.to_numeric(df["prix_bien"], errors="coerce") /
                                       pd.to_numeric(df["surface"], errors="coerce")).replace([np.inf,-np.inf], np.nan)
        else:
            raise ValueError("Colonne 'prix_m2_vente' absente et impossible à dériver (prix_bien/surface manquants).")
    return df

def cp_str(s: pd.Series) -> pd.Series:
    out = s.astype(str).str.replace(r"\.0$", "", regex=True).str.strip()
    return out.where(out.str.match(r"^\d{5}$"), other="inconnu")

def _ensure_code_postal(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    cands = ["codePostal","code_postal","Code_postal","cp","CP"]
    col = next((c for c in cands if c in df.columns), None)
    if col is None:
        df["codePostal"] = "inconnu"
    else:
        df["codePostal"] = cp_str(df[col])
    return df

def departement_from_cp(cp: pd.Series) -> pd.Series:
    dep = cp.astype(str).str[:2].where(cp != "inconnu", other="inconnu")
    dep = dep.mask(cp.astype(str).str.startswith("97"), cp.astype(str).str[:3])
    dep = dep.mask(cp.astype(str).str.startswith("20"), "2A")
    return dep.fillna("inconnu")

def month_key(dt: pd.Series) -> pd.Series:
    dt = pd.to_datetime(dt, errors="coerce")
    return (dt.dt.year.astype("Int64").astype(str) + "-" + dt.dt.month.astype("Int64").astype(str).str.zfill(2))

def tcam_from_series(df: pd.DataFrame, y_col: str = "prix_m2_vente") -> pd.Series:
    g = df.dropna(subset=[y_col, "t"]).copy()
    if g.empty: 
        zones = df["zone"].unique() if "zone" in df.columns else []
        return pd.Series({z: np.nan for z in zones})
    g["logy"] = np.log(g[y_col].astype(float).clip(lower=1e-9))
    def _one(sub: pd.DataFrame) -> float:
        sub = sub.dropna(subset=["logy", "t"])
        if len(sub) < 2: return np.nan
        coef = LinearRegression().fit(sub[["t"]].values, sub["logy"].values).coef_[0]
        return (np.exp(coef) - 1) * 100 * 12
    return g.groupby("zone").apply(_one)

def ensure_clusters_always(df_full: pd.DataFrame, zone_col: str, k_default: int = 4) -> pd.DataFrame:
    agg = (df_full.groupby(["ym", zone_col], dropna=False)
                 .agg(prix_m2_vente=("prix_m2_vente","mean")).reset_index())
    if agg.empty:
        log("WARN: aucune agrégation produite -> fallback quantiles globaux.")
        q = pd.qcut(df_full["prix_m2_vente"], q=4, labels=False, duplicates="drop")
        labels = q.fillna(0).astype(int)
        df_full["cluster"] = labels
        name_map = {0:"bas",1:"moyen-",2:"moyen+",3:"haut"}
        df_full["cluster_label"] = df_full["cluster"].map(name_map).fillna("moyen")
        return df_full

    ym = pd.to_datetime(agg["ym"] + "-01", errors="coerce")
    agg["ym_num"] = ym.dt.year * 12 + ym.dt.month
    agg["t"] = agg.groupby(zone_col)["ym_num"].transform(lambda x: x - x.min())
    agg["zone"] = agg[zone_col].astype(str)

    tcam = tcam_from_series(agg, y_col="prix_m2_vente")

    feats = (agg.groupby(zone_col)
               .agg(y_mean=("prix_m2_vente","mean"),
                    y_std =("prix_m2_vente","std"),
                    y_min =("prix_m2_vente","min"),
                    y_max =("prix_m2_vente","max"))
               .reset_index())
    feats["cv"] = feats["y_std"] / feats["y_mean"]
    feats["tcam"] = feats[zone_col].map(tcam)

    X = feats[["y_mean","y_std","y_min","y_max","cv","tcam"]].replace([np.inf,-np.inf], np.nan)
    Xn = X.dropna()
    if len(Xn) < 2:
        log("WARN: trop peu de zones pour KMeans -> fallback quantiles sur y_mean.")
        q = pd.qcut(feats["y_mean"], q=min(4, max(1, len(feats))), labels=False, duplicates="drop")
        feats["cluster"] = q.fillna(0).astype(int)
    else:
        Xs = StandardScaler().fit_transform(Xn.values)
        ks = list(range(2, min(8, len(Xn))+1))
        models, sils = [], []
        for k in ks:
            km = KMeans(n_clusters=k, random_state=42, n_init="auto")
            lab = km.fit_predict(Xs)
            models.append(km)
            try: sils.append(silhouette_score(Xs, lab))
            except Exception: sils.append(np.nan)
        k_best = ks[int(np.nanargmax(sils))] if any(np.isfinite(sils)) else min(4, len(Xn))
        mlflow.log_metric("silhouette_score", sil)
        mlflow.log_metric("n_clusters", k)
        plt.scatter(X[:,0], X[:,1], c=labels)
        plt.savefig("cluster_map.png")
        mlflow.log_artifact("cluster_map.png")
        if k_best >= len(Xn): k_best = max(2, len(Xn)-1)
        km = models[ks.index(k_best)]
        labels = pd.Series(km.predict(Xs), index=Xn.index)
        feats["cluster"] = 0
        feats.loc[Xn.index, "cluster"] = labels.astype(int)

    order = feats.groupby("cluster")["y_mean"].mean().sort_values().index.tolist()
    names = ["bas","moyen-","moyen+","haut","très haut","premium"]
    name_map = {c: names[i % len(names)] for i,c in enumerate(order)}
    feats["cluster_label"] = feats["cluster"].map(name_map)

    out = df_full.merge(feats[[zone_col,"cluster","cluster_label"]], on=zone_col, how="left")
    out["cluster"] = out["cluster"].fillna(0).astype(int)
    out["cluster_label"] = out["cluster_label"].fillna("moyen")
    return out

def _fallback_quantiles(df_full: pd.DataFrame, zone_col: str) -> pd.DataFrame:
    q = pd.qcut(df_full["prix_m2_vente"], q=4, labels=False, duplicates="drop")
    df_full = df_full.copy()
    df_full["cluster"] = q.fillna(0).astype(int)
    name_map = {0:"bas",1:"moyen-",2:"moyen+",3:"haut"}
    df_full["cluster_label"] = df_full["cluster"].map(name_map).fillna("moyen")
    return df_full

@click.command()
@click.option("--input-dir", type=click.Path(exists=True, file_okay=False), required=True,
              help="Dossier contenant df_sales_clean_train.csv et df_sales_clean_test.csv")
@click.option("--output-dir", type=click.Path(), default="exports", show_default=True,
              help="Ecrit df_cluster.csv et df_sales_clean_ST.csv")
def main(input_dir: str, output_dir: str):
    try:
        in_dir = Path(input_dir)
        out_dir = Path(output_dir)
        ensure_dirs(out_dir)

        # lecture train/test (tolérante: si un des deux manque, on continue avec l'autre)
        dfs = []
        for fn in ["df_sales_clean_train.csv", "df_sales_clean_test.csv"]:
            p = in_dir / fn
            if p.exists():
                dfp = _read_csv(p)
                dfp["split"] = "train" if "train" in fn else "test"
                dfs.append(dfp)
        if not dfs:
            raise FileNotFoundError(f"Aucun des fichiers attendus n'existe dans {in_dir}")
        df = pd.concat(dfs, ignore_index=True)

        # garanties colonnes nécessaires
        df = _ensure_prix_m2(df)
        df = _ensure_date(df)
        df = _ensure_code_postal(df)
        df["dep_zone"] = departement_from_cp(df["codePostal"])
        df["ym"] = month_key(df["date"])
        df = df.dropna(subset=["prix_m2_vente"]).copy()

        # MLflow
        mlflow.set_experiment("Clustering")
        with mlflow.start_run(run_name="clustering"):
            mlflow.log_param("n_input_rows", int(len(df)))
            mlflow.log_param("n_dep_zones", int(df["dep_zone"].nunique()))

            try:
                out = ensure_clusters_always(df, zone_col="dep_zone", k_default=4)
            except Exception as e:
                log("[WARN] Clustering primary a échoué -> fallback quantiles:", e)
                out = _fallback_quantiles(df, "dep_zone")

            st_path = out_dir / "df_sales_clean_ST.csv"
            cl_path = out_dir / "df_cluster.csv"
            out.drop(columns=["split"], errors="ignore").to_csv(st_path, sep=";", index=False)
            out.to_csv(cl_path, sep=";", index=False)

            # artefacts
            try:
                mlflow.log_artifact(str(st_path), artifact_path="clustering_output")
                mlflow.log_artifact(str(cl_path), artifact_path="clustering_output")
            except Exception: pass

            log("OK: écrits", cl_path, "et", st_path)
    except Exception as e:
        log("[FATAL] clustering failed:", e)
        traceback.print_exc()
        sys.exit(1)

if __name__ == "__main__":
    main()

