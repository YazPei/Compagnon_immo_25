# dvc.yaml — racine du repo
stages:
  import_data:
    cmd: python scripts/import_data.py
    deps:
      - scripts/import_data.py
    outs:
      - path: data/df_sample.csv
        cache: false
        persist: true

  preprocessing:
    cmd: python scripts/preprocessing.py
    deps:
      - scripts/preprocessing.py
      - data/df_sample.csv
    outs:
      - path: data/processed
        cache: false
        persist: true

  encode:
    cmd: python scripts/encode.py
    deps:
      - scripts/encode.py
      - data/processed
    outs:
      - path: data/encoded/X_train.csv
        cache: false
        persist: true

  train_lgbm:
    cmd: python scripts/train_lgbm.py
    deps:
      - scripts/train_lgbm.py
      - data/encoded/X_train.csv
    outs:
      - path: data/encoded/lgbm_model.joblib
        cache: false
    metrics:
      - path: metrics/train_lgbm.json
        cache: false
    plots:
      - path: reports/feature_importance.json
        cache: false

  splitst:
    cmd: python scripts/splitst.py
    deps:
      - scripts/splitst.py
      - data/processed
    outs:
      - path: data/split
        cache: false
        persist: true

  decompose:
    cmd: python scripts/decompose.py
    deps:
      - scripts/decompose.py
      - data/split
    outs:
      - path: outputs/decomposition/decomposition_additive_cluster_0.png
        cache: false

  train_sarimax:
    cmd: python scripts/train_sarimax.py
    deps:
      - scripts/train_sarimax.py
      - data/split
    outs:
      - path: outputs/best
        cache: false
        persist: true

  evaluate:
    cmd: python scripts/evaluate.py
    deps:
      - scripts/evaluate.py
      - outputs/best
    outs:
      - path: outputs/evaluate
        cache: false
        persist: true

